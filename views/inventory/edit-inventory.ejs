<% 
  // Check if the 'title' variable is defined.
  if (title) { 
%>
    <h1><%= title %></h1> <!-- Render the title within an H1 tag -->
<% 
  } else { 
    // If 'title' is not defined, redirect to the home page.
    res.redirect('/'); 
  } 
%>

<% if (errors) { %>
    <ul class="notice">
    <% for (let i = 0; i < errors.length; i++) { %>
      <% if (errors[i].msg == "Invalid value") { %>
        <% errors.splice(i, 1) %>
      <% } %>
      <li><%= errors[i].msg %></li>
    <% } %>
    </ul>
<% } else { %>
    <%# console.log('No errors to display'); %>
<% } %>

<%- flashMessage() %>

<%# editInventoryForm %>

<form action="/inv/update-inventory" method="POST" id="edit-inventory-form">
  <fieldset>
    <legend>Edit Inventory Vehicle</legend>

    <label for="classification-list">Classification: </label>
    <%- classificationSelectionOptionsList %>

    <label for="inv_make">Make: </label>
    <input type="text" 
           name="inv_make" 
           id="inv_make" 
           value="<%= inv_make %>"><br>

    <label for="inv_model">Model: </label>
    <input type="text" 
           name="inv_model" 
           id="inv_model" 
           value="<%= inv_model %>"><br>

    <label for="inv_year">Year: </label>
    <input type="text" 
           name="inv_year" 
           id="inv_year" 
           value="<%= inv_year %>"><br>

    <label for="inv_description">Description: </label>
    <textarea name="inv_description" 
              id="inv_description" ><%= inv_description %></textarea><br>

    <label for="inv_image">Image: </label>
    <input type="text" 
           name="inv_image" 
           id="inv_image" 
           value="<%= inv_image %>"><br>

    <label for="inv_thumbnail">Thumbnail: </label>
    <input type="text" 
           name="inv_thumbnail" 
           id="inv_thumbnail" 
           value="<%= inv_thumbnail %>"><br>

    <label for="inv_price">Price: </label>
    <input type="text" 
           name="inv_price" 
           id="inv_price" 
           value="<%= inv_price %>"><br>

    <label for="inv_miles">Miles: </label>
    <input type="text" 
           name="inv_miles" 
           id="inv_miles" 
           value="<%= inv_miles %>"><br>

    <label for="inv_color">Color: </label>
    <input type="text" 
           name="inv_color" 
           id="inv_color" 
           value="<%= inv_color %>"><br>

    <input type="hidden" name="inv_id" value="<%= inv_id %>">

    <%# OR - Use `locals.inv_id` if `inv_id` exists in the locals object %> 
    <!--
       <input type="hidden" name="inv_id"
       <%# if(locals.inv_id) { %> 
            value="<%# locals.inv_id %>"
       <%# } %>
       ><br>
    -->
  </fieldset>

  <button type="submit" disabled>Update Inventory</button>
</form>

<script src="../../js/inv-update.js"></script>

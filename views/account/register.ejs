<% 
  // Check if the 'title' variable is defined.
  if (title) { 
%>
    <h1><%= title %></h1>
<% 
  } else { 
    // If 'title' is not defined, redirect to the home page.
    res.redirect('/'); 
  } 
%>

<%- flashMessage() %>

<% if (errors) { %>
    <ul class="notice">
    <% for (let i = 0; i < errors.length; i++) { %>
      <% i = i +1 %> 
      <li><%= errors[i].msg %></li>
    <% } %>
    </ul>
<% } %>

<%- registerForm %> <%# Note: to see literal HTML markup, use "=" instead of "-" %>
